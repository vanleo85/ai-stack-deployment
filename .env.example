# === Docker Compose: vLLM deployment ===

# HuggingFace model name or path (e.g. Qwen/Qwen2.5-14B-Instruct-AWQ, meta-llama/Llama-3-8B)
QWEN_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ

# Host port to expose the vLLM OpenAI-compatible API
QWEN_PORT=8000

# Internal container port for the vLLM server (must match the port in vLLM --port flag)
VLLM_PORT=8000

# HuggingFace access token for private/gated models
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key for client authentication (OpenAI Bearer token)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VLLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === vLLM Performance (CUDA graphs ON for max throughput) ===

# GPU memory utilization fraction (0.0-1.0)
# 0.95 is safe with CUDA graphs on 24GB GPU (32B AWQ model ~18-20GB)
VLLM_GPU_MEMORY_UTILIZATION=0.95

# Maximum concurrent sequences (requests) in batch
# Lower for 32B model (less KV cache available)
VLLM_MAX_NUM_SEQS=16

# Maximum tokens processed per batch iteration
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# Maximum context length in tokens
VLLM_MAX_MODEL_LEN=8192

# Scheduling policy: fcfs (first-come-first-served)
VLLM_SCHEDULING_POLICY=fcfs

# Prometheus metrics port (for monitoring)
VLLM_METRICS_PORT=9090

# Disable CUDA graphs (saves ~4GB GPU memory, but ~30% slower)
# Set to 'true' to disable CUDA graphs; leave empty or 'false' for max performance
VLLM_ENFORCE_EAGER=false

# Chunked prefill: reduces head-of-line blocking for long generations
VLLM_ENABLE_CHUNKED_PREFILL=true

# Prefix caching: speeds up repeated system prompts
VLLM_ENABLE_PREFIX_CACHING=true

# === Reasoning + Structured Output ===
# Qwen2.5 does not have thinking mode — reasoning parser not needed
VLLM_ENABLE_REASONING=false

# === Embedding / Reranker models (Text Embeddings Inference) ===

# Embedding model (BAAI/bge-m3 ~568M params, ~3GB VRAM)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_PORT=6006

# Reranker model (BAAI/bge-reranker-v2-m3 ~568M params, ~1.2GB VRAM)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PORT=6007

# === GPU Embedding (TEI GPU image) ===
# Аналог сервиса `embedding`, но с ускорением на NVIDIA GPU.
# Тот же API POST /embed (inputs -> [[float x 1024]]) и та же модель.
# Пулинг TEI читает из 1_Pooling/config.json модели (у bge-m3 — CLS),
# поэтому --pooling не нужен.

# Тег образа — см. таблицу GPU -> тег в секции «GPU Reranker» ниже.
# Таблица общая для обоих GPU-сервисов (embedding-gpu и reranker-gpu).
EMBEDDING_GPU_IMAGE_TAG=89-1.9

# Модель-эмбеддер (по умолчанию совпадает с CPU-вариантом для сравнимости)
EMBEDDING_GPU_MODEL=BAAI/bge-m3

# Host port для GPU-embedding
EMBEDDING_GPU_PORT=6009

# Точность. На CUDA-образах TEI принимается только float16 и float32.
# float16 — дефолт GPU и единственный режим с Flash Attention.
# ВАЖНО для embedding'ов: fp16 может незначительно сдвинуть cosine-ранжирование
# против fp32 CPU-эталона. Проверяйте сверкой: cosine(vec_6006, vec_6009) ~ 1.0.
EMBEDDING_GPU_DTYPE=float16

# Батчинг. 16384 — дефолт TEI. Значения выставлены явно для тюнинга.
EMBEDDING_GPU_MAX_BATCH_TOKENS=16384
EMBEDDING_GPU_MAX_CLIENT_BATCH_SIZE=64

# === GPU Reranker (TEI GPU image) ===
# Аналог сервиса `reranker`, но с ускорением на NVIDIA GPU.
# Тот же API POST /rerank (query + texts + top_n) и та же модель.

# Тег TEI GPU-образа. ВАЖНО: теги архитектурно-зависимые, тега `gpu-latest`
# НЕ существует. У каждого префикса есть и версионный тег, и `-latest`.
# Соответствие GPU -> префикс (официальный README HuggingFace TEI):
#   Turing   (T4, CC 7.5, experimental)      -> turing-<ver>
#   Ampere   8.0 (A100, A30)                 -> <ver>          например 1.9
#   Ampere   8.6 (A10, A40, RTX 3080/3090)   -> 86-<ver>
#   Ada      8.9 (RTX 4080/4090)             -> 89-<ver>
#   Hopper   9.0 (H100)                      -> hopper-<ver>
#   Blackwell (B200/GB200, RTX 50, GB10)     -> 100-<ver> / 120-<ver> / 121-<ver>
# Есть также multi-arch `cuda-<ver>` / `cuda-latest` со всеми бинарниками
# (75/80/90/100/120). Для конкретной карты предпочтительнее архитектурный тег:
# `cuda-*` для CC 8.6-8.9 запускает бинарник `-80`, а не профильный под 8.9.
# Требования: драйвер с CUDA 12.2+, compute capability >= 7.5,
# NVIDIA Container Toolkit. Текущий релиз TEI: 1.9.4 (теги вида `89-1.9`).
# Для повторяемости деплоя пиньте патч-версию: `89-1.9.4` вместо `89-1.9`.
RERANKER_GPU_IMAGE_TAG=89-1.9

# Модель-кросс-энкодер (по умолчанию совпадает с CPU-вариантом для сравнимости)
RERANKER_GPU_MODEL=BAAI/bge-reranker-v2-m3

# Host port для GPU-reranker
RERANKER_GPU_PORT=6008

# Точность. На CUDA-образах TEI принимает только float16 и float32
# (bfloat16 недоступен вне python-сборки). float16 — дефолт GPU и единственный
# режим, в котором включается Flash Attention (USE_FLASH_ATTENTION=True
# включён в образе по умолчанию).
RERANKER_GPU_DTYPE=float16

# Батчинг. 16384 — дефолт TEI, 32 — дефолт --max-client-batch-size.
# Значения здесь выставлены явно для тюнинга; 64 — верхняя граница размера
# запроса клиента, а не резерв VRAM.
RERANKER_GPU_MAX_BATCH_TOKENS=16384
RERANKER_GPU_MAX_CLIENT_BATCH_SIZE=64
