# === Docker Compose: vLLM deployment ===

# HuggingFace model name or path (e.g. Qwen/Qwen3.5-9B, meta-llama/Llama-3-8B)
QWEN_MODEL=Qwen/Qwen3.5-9B

# Host port to expose the vLLM OpenAI-compatible API
QWEN_PORT=8000

# Internal container port for the vLLM server (must match the port in vLLM --port flag)
VLLM_PORT=8000

# HuggingFace access token for private/gated models
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# API key for client authentication (OpenAI Bearer token)
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
VLLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === vLLM Performance (CUDA graphs ON for max throughput) ===

# GPU memory utilization fraction (0.0-1.0)
# 0.92 is safe with CUDA graphs on 24GB GPU (model=17.66 GiB)
VLLM_GPU_MEMORY_UTILIZATION=0.92

# Maximum concurrent sequences (requests) in batch
VLLM_MAX_NUM_SEQS=64

# Maximum tokens processed per batch iteration
VLLM_MAX_NUM_BATCHED_TOKENS=16384

# Maximum context length in tokens (must match model's max context)
VLLM_MAX_MODEL_LEN=16384

# Scheduling policy: fcfs (first-come-first-served)
VLLM_SCHEDULING_POLICY=fcfs

# Prometheus metrics port (for monitoring)
VLLM_METRICS_PORT=9090

# Disable CUDA graphs (saves ~4GB GPU memory, but ~30% slower)
# Set to 'true' to disable CUDA graphs; leave empty or 'false' for max performance
VLLM_ENFORCE_EAGER=false

# Chunked prefill: reduces head-of-line blocking for long generations
VLLM_ENABLE_CHUNKED_PREFILL=true

# Prefix caching: speeds up repeated system prompts
VLLM_ENABLE_PREFIX_CACHING=true

# === Embedding / Reranker models (Text Embeddings Inference) ===

# Embedding model (BAAI/bge-m3-v2 ~568M params, ~3GB VRAM)
EMBEDDING_MODEL=BAAI/bge-m3-v2
EMBEDDING_PORT=6006

# Reranker model (BAAI/bge-reranker-v2-m3 ~568M params, ~1.2GB VRAM)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_PORT=6007
