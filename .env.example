# === Docker Compose: vLLM deployment ===

# HuggingFace model name or path (e.g. Qwen/Qwen3.5-9B, meta-llama/Llama-3-8B)
QWEN_MODEL=Qwen/Qwen3.5-9B

# Host port to expose the vLLM OpenAI-compatible API
QWEN_PORT=8000

# Internal container port for the vLLM server (must match the port in vLLM --port flag)
VLLM_PORT=8000

# HuggingFace access token for private/gated models (uncomment in docker-compose.yml to use)
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === vLLM Performance ===

# GPU memory utilization fraction (0.0-1.0). Higher = more KV cache = more concurrent requests
VLLM_GPU_MEMORY_UTILIZATION=0.92

# Maximum concurrent sequences (requests) in batch. Increase for higher throughput
VLLM_MAX_NUM_SEQS=128

# Maximum tokens processed per batch iteration
VLLM_MAX_NUM_BATCHED_TOKENS=16384

# Maximum context length in tokens (must match model's max context)
VLLM_MAX_MODEL_LEN=16384

# Scheduling policy: fcfs (first-come-first-served)
VLLM_SCHEDULING_POLICY=fcfs

# Prometheus metrics port (for monitoring)
VLLM_METRICS_PORT=9090

# === llm_tests: Load testing ===

# vLLM server connection (used by Locust tests)
# VLLM_HOST=http://localhost:8000
# VLLM_BASE_PATH=/v1/chat/completions
# VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# VLLM_API_KEY=token-abc123
# VLLM_REQUEST_TIMEOUT=300
# VLLM_TOP_K=40
# VLLM_TEMPERATURE=0.0
# VLLM_SEED=
